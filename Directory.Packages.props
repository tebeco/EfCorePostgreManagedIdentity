<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  
  <ItemGroup Label="Apis">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    
    <PackageVersion Include="Scalar.AspNetCore" Version="2.*" />
    <PackageVersion Include="Scalar.AspNetCore.Microsoft" Version="2.*" />

    <PackageVersion Include="Azure.Identity" Version="1.*" />

  </ItemGroup>
  
  <ItemGroup Label="EfCore">
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" />
    
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.*" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.*" />
    <PackageVersion Include="NSubstitute" Version="5.*" />

    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.*" />

    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.*" />
  </ItemGroup>

</Project>
